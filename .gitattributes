# Shell scripts and what is installed on the head unit run under Linux
# (busybox ash on the unit, sh in the build containers): LF, whatever
# core.autocrlf says.
*.sh text eol=lf
native/hook111/** text eol=lf
# patches applied in Linux containers, and their generator
*.patch text eol=lf
native/vizualyse-steam/tools/*.py text eol=lf
native/vizualyse-steam/image/*.Dockerfile text eol=lf
# the bus's source edit, run by awk in a Linux container
native/vizualyse-bus/patches/* text eol=lf
