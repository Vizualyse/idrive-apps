# mgu-emu: stand-ins for the car-side SOME/IP services (carsim/carsim.js):
# lifecycle, the centre display, vehicle condition (PWF), key, vehicle (units /
# language), the iDrive controller. Started before the HMI; root, like a Store
# root tool. No default dependencies, like vsomeipd and earlyhmi: with them
# (After=basic.target) early.target -> earlyhmi -> carsim -> basic.target ->
# sysinit.target is a cycle, and systemd may break it by dropping early.target,
# which leaves carsim (and with it touch) out of the boot.
[Unit]
Description=mgu-emu car stand-ins (SOME/IP)
DefaultDependencies=no
Conflicts=shutdown.target
Before=shutdown.target
Wants=vsomeipd.service
After=vsomeipd.service
Before=hmi.service earlyhmi.service

[Service]
ExecStartPre=/usr/bin/node /usr/lib/mgu-emu/carsim/policy.js
ExecStart=/usr/bin/node /usr/lib/mgu-emu/carsim/carsim.js --ctl /run/carsim/ctl
RuntimeDirectory=carsim
Restart=on-failure
RestartSec=2

[Install]
WantedBy=early.target
