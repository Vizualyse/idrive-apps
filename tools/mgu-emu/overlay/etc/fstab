# mgu-emu: the unit's fstab with its eMMC partitions as directories on the
# one virtual disk (/emu/*), bind-mounted where the unit mounts them, so the
# generated mount units (mnt-dataro, var-opt, var-sys) and the targets that
# require them still work.
/dev/root            /                        auto       rw,noatime                                     1  0
proc                 /proc                    proc       defaults                                       0  0
devpts               /dev/pts                 devpts     mode=0620,gid=5                                0  0
tmpfs                /run                     tmpfs      mode=0755,nodev,nosuid,strictatime             0  0
tmpfs                /var/volatile            tmpfs      defaults                                       0  0
tmpfs                /media                   tmpfs      mode=0755,nodev,nosuid,noatime                 0  0
tmpfs                /var/cache/mapramdisk    tmpfs      noauto,size=40m,mode=0775,strictatime,gid=6200 0  0
tmpfs                /var/cache/mediaramdisk  tmpfs      noauto,size=50m,mode=0775,strictatime,gid=4150 0  0
tmpfs                /var/cache/projectedmodes tmpfs      noauto,size=2m,mode=0775,strictatime,gid=13007 0  0
/emu/dataro          /mnt/dataro              none       bind,x-systemd.before=local-fs.target           0  0
/emu/opt             /var/opt                 none       bind,x-systemd.before=local-fs.target           0  0
/emu/sys             /var/sys                 none       bind,x-systemd.before=system-data-fs.target     0  0
/run/hmi/iba.squashfs   /mnt/iba/ibaroot       squashfs        ro,noauto,nodev,nosuid,users,loop 0  0
