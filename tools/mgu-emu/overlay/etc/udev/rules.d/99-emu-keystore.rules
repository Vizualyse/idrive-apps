# mgu-emu: the unit's Intel keystore device is not emulated; its users get a
# software keystore (kspreload, /etc/ld.so.preload), and systemd needs only the device
# to exist (dev-keystore.device): /dev/zero stands in for it.
KERNEL=="zero", SUBSYSTEM=="mem", TAG+="systemd", ENV{SYSTEMD_ALIAS}+="/dev/keystore"
