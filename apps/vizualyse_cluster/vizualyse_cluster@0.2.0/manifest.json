{
  "proxies": {
    "de.bmw.infotainment.telematic.oapcontroller.OAPController": "*",
    "de.bmw.infotainment.hmi.remote.RemoteHmi": "*",
    "de.bmw.infotainment.hmi.remote.RemoteHmiApplication": "*",
    "de.bmw.infotainment.hmi.entrypoint.EntryPoint": "*",
    "de.bmw.infotainment.hmi.entrypoint.EntryPointManager": "*",
    "de.bmw.infotainment.hmi.resourcemanagement.ResourceManager": "*",
    "de.bmw.infotainment.hmi.resourcemanagement.ResourceBundle": "*",
    "de.bmw.infotainment.hmi.resourcemanagement.StringBundle": "*",
    "de.bmw.infotainment.telematic.oap.PrivateEntryPoint": {
      "instances": [
        "${userId}"
      ],
      "methods": [
        "registerEntryPoint",
        "unregisterEntryPoint",
        "setSelected",
        "setAvailability"
      ]
    },
    "de.bmw.infotainment.telematic.oap.AppBookmarks": {
      "instances": [
        "${userId}"
      ],
      "methods": [
        "registerBookmark"
      ]
    },
    "de.bmw.infotainment.telematic.oap.WakeUpOnDemand": {
      "instances": [
        "${userId}"
      ],
      "methods": [
        "registerParticipant",
        "unregisterParticipant"
      ]
    },
    "de.bmw.infotainment.telematic.oap.WodControl": {
      "instances": "${userId}",
      "methods": [
        "offerService",
        "stopOfferingService"
      ]
    },
    "de.bmw.infotainment.telematic.provisioning.Provisioning": {
      "instances": "1",
      "broadcasts": [
        "provisioningDataJSON"
      ],
      "methods": [
        "getValueJSON",
        "setFilterForProvisioningData"
      ]
    },
    "de.bmw.infotainment.vehicle.Vehicle": "*",
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "instances": [
        "1"
      ],
      "attributes": {
        "statusCarSpeed2": "rs"
      }
    },
    "de.bmw.infrastructure.EnvironmentalInformation": "*",
    "de.bmw.infotainment.certification.Certification": "*",
    "de.bmw.infotainment.vehicle.CDS": {
      "instances": [
        "1"
      ],
      "attributes": {
        "statusEngineSpeed2": "rs",
        "statusEngineTemperature": "rs"
      }
    },
    "de.bmw.infotainment.vehicle.CDS2": {
      "instances": [
        "1"
      ],
      "attributes": {
        "statusLateralAccelerationMassCenter": "rs",
        "statusLongitudinalAccelerationMassCenter": "rs"
      }
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "instances": [
        "1"
      ],
      "attributes": {
        "DataPowerTrain2": "s"
      }
    },
    "de.bmw.infotainment.misc.MDrive": {
      "instances": [
        "1"
      ],
      "attributes": {
        "dataDisplayGearbox": "s"
      }
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "instances": [
        "1"
      ],
      "attributes": {
        "statusFESVehicleDynamicSwitchHMI": "rs",
        "statusActualValueTorque2": "rs",
        "statusSwitchDriveDynamicSport2": "rs"
      }
    },
    "de.bmw.powertrain.AcceleratorPedal": {
      "instances": [
        "1"
      ],
      "attributes": {
        "AngleAcceleratorPedal": "s"
      }
    },
    "de.bmw.infotainment.KombiIF": {
      "instances": [
        "1"
      ],
      "attributes": {
        "statusRangeTankStatus": "rs",
        "displayRangeElectricVehicle": "rs",
        "statusBordcomputerTravelData": "rs",
        "statusBordcomputerAverage": "rs"
      }
    },
    "de.bmw.infotainment.drivingexcitement.Efficiencytainment2": {
      "instances": [
        "1"
      ],
      "attributes": {
        "statusChargeOfBatteryHybrid": "rs"
      }
    },
    "de.bmw.infotainment.vehicle.TPMS": {
      "instances": [
        "1"
      ],
      "attributes": {
        "statusTyrePressure": "rs",
        "statusTyreTemperature": "rs"
      }
    }
  },
  "services": {
    "de.bmw.infotainment.telematic.oap.AppStatus": {
      "instances": [
        "${userId}"
      ]
    }
  }
}
