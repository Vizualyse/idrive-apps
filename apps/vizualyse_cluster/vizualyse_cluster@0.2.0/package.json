{
  "name": "vizualyse_cluster",
  "version": "0.2.0",
  "description": "Cluster themes: chooses the instrument cluster theme (the vizualyse-cluster tool): a picker on the central screen with a preview of every theme, touched, a Try on the cluster while parked, Sport or Comfort, on or off",
  "private": false,
  "main": "javascript/runner.js",
  "oapAppSettings": {
    "maxDiskUsage": 26214400,
    "cpuLimit": 50,
    "memoryThresholdKB": 153600,
    "priority": "PRIO_MEDIUM",
    "visibility": "FOREGROUND",
    "latencyClass": "FOREGROUND",
    "loggingId": "VCLU",
    "userLoginRequired": false,
    "backgroundPriority": 150,
    "someipManifest": "manifest.json"
  },
  "files": [
    "config",
    "rhmiData",
    "package.json",
    "npm-shrinkwrap.json",
    "permissions.json",
    "javascript",
    "manifest.json",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dependencies": {
    "oap-sdk": "24.10.2"
  },
  "engines": {
    "node": ">=8.7.0"
  },
  "keywords": [
    "node",
    "BMW",
    "Online",
    "ConnectedDrive"
  ],
  "author": "Yousaf Khan",
  "license": "GPL-3.0-or-later",
  "mguLocalOnly": true
}
