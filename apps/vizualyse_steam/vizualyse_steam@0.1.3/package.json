{
  "name": "vizualyse_steam",
  "version": "0.1.3",
  "description": "Steam: plays Windows games from your Steam library on the car (the vizualyse-steam tool), shows the phone link and QR code for signing in and installing, and shows or hides the game on the central screen",
  "private": false,
  "main": "javascript/runner.js",
  "oapAppSettings": {
    "maxDiskUsage": 26214400,
    "cpuLimit": 50,
    "memoryThresholdKB": 153600,
    "priority": "PRIO_MEDIUM",
    "visibility": "FOREGROUND",
    "latencyClass": "FOREGROUND",
    "loggingId": "VSTM",
    "userLoginRequired": false,
    "backgroundPriority": 150,
    "someipManifest": "manifest.json"
  },
  "files": [
    "config",
    "rhmiData",
    "package.json",
    "npm-shrinkwrap.json",
    "permissions.json",
    "javascript",
    "manifest.json",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dependencies": {
    "oap-sdk": "24.10.2"
  },
  "engines": {
    "node": ">=8.7.0"
  },
  "keywords": [
    "node",
    "BMW",
    "Online",
    "ConnectedDrive"
  ],
  "author": "Yousaf Khan",
  "license": "GPL-3.0-or-later",
  "mguLocalOnly": true
}
