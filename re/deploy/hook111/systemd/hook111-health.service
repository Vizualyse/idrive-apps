[Unit]
Description=hook111: watch carplay for an armed start (healthy after 60 s; a crash recorded at once)
RequiresMountsFor=/var/opt
After=hook111-arm.service carplay.service

[Service]
Type=simple
# An armed start only (otherwise it exits at once): checks /proc/<carplay>
# every second and systemctl every 5 s (bounded), writes its state on
# /var/opt when carplay turns healthy or crashes. Never touches carplay.
ExecStart=-/bin/sh /var/opt/hook111/current/hook111-arm.sh health
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
