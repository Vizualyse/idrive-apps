{
  "id": "vizualyse-cluster",
  "kind": "tool",
  "version": "0.2.0",
  "license": "GPL-3.0-or-later",
  "title": "Cluster themes",
  "description": "EXPERIMENTAL, NOT YET TRIED ON A CAR. Whole-cluster themes drawn over the instrument cluster through cluster-render's panel target, under the car's own warning lights: eight families (G20 inspired 1 and 2, LCI inspired 1 and 2, Three-dial 1 and 2, Performance 1 and 2), each a Sport and a Comfort theme switched by the drive mode. Drawn by small shaders on the cluster with textures sent once (about 1.7-3.1 MB at start), so only a few KB/s of numbers cross the link while driving. Readings the car does not give show as --. Chosen on the central screen by touch, with a preview of each theme and a 10 s try on the cluster while parked (the Cluster themes iDrive app). About 12 MB.",
  "requires": {
    "mgu-deploy": "0.7.0",
    "mgu-python": "1.0.0",
    "mgu-render": "0.6.11",
    "cluster-render": "0.5.4"
  },
  "uninstallable": true,
  "mguHmi": [
    "ID7"
  ],
  "platform": {
    "tool/cluster_render_client": {
      "version": "1.0.0",
      "files": {
        "src/cluster_render_client.js": "cluster_render_client.js"
      }
    }
  },
