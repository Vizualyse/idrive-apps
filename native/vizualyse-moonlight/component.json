{
  "id": "vizualyse-moonlight",
  "kind": "tool",
  "version": "0.2.4",
  "license": "GPL-3.0-or-later",
  "title": "Moonlight",
  "description": "EXPERIMENTAL. Streams games from a PC running Sunshine (GameStream) to the central screen (or the cluster or the HUD) while parked, decoded on the car's GPU, with the sound through the speakers and game controllers (a wired Xbox 360-style USB pad, or the phone as a pad; no Bluetooth pads). Pair the PC and pick a game on the phone page: scan the QR code on the iDrive Moonlight page.",
  "requires": {
    "mgu-deploy": "0.7.0",
    "cluster-render": "0.4.2",
    "mgu-python": "1.0.0",
    "mgu-render": "0.6.11"
  },
  "uninstallable": true,
  "mguHmi": [
    "ID7"
  ],
  "internet": true,
  "uids": [
    12998
  ],
  "deactivate": [
    "node",
    "firewall.js",
    "remove"
  ],
  "build": [
    "sh",
    "build.sh"
  ],
  "platform": {
    "native/frame_out": { "version": "1.0.0", "files": { "core/frame_out.c": "frame_out.c", "core/frame_out.h": "frame_out.h" } },
    "native/touch": { "version": "1.0.0", "files": { "core/touch.c": "touch.c", "core/touch.h": "touch.h" } },
    "native/winston_out": { "version": "1.0.0", "files": { "core/winston_out.c": "winston_out.c", "core/winston_out.h": "winston_out.h", "core/protocol/ivi-application.xml": "ivi-application.xml", "core/protocol/ivi-controller.xml": "ivi-controller.xml", "core/protocol/linux-dmabuf-unstable-v1.xml": "linux-dmabuf-unstable-v1.xml" } },
    "tool/cluster_render_client": { "version": "1.0.0", "files": { "src/cluster_render_client.js": "cluster_render_client.js" } },
    "tool/pcm_play": { "version": "1.0.0", "files": { "src/pcm_play.py": "pcm_play.py" } }
  },
  "files": [
    {
      "path": "server.js",
      "from": "src/server.js",
      "mode": "0644"
    },
    {
      "path": "gamestream.js",
      "from": "src/gamestream.js",
      "mode": "0644"
    },
    {
      "path": "gs_worker.js",
      "from": "src/gs_worker.js",
      "mode": "0644"
    },
    {
      "path": "firewall.js",
      "from": "src/firewall.js",
      "mode": "0644"
    },
    {
      "path": "console_out.js",
      "from": "src/console_out.js",
      "mode": "0644"
    },
    {
      "path": "cluster_render_client.js",
      "from": "src/cluster_render_client.js",
      "mode": "0644"
    },
    {
      "path": "control.js",
      "from": "src/control.js",
      "mode": "0644"
    },
    {
      "path": "page.html",
      "from": "src/page.html",
      "mode": "0644"
    },
    {
      "path": "pcm_play.py",
      "from": "src/pcm_play.py",
      "mode": "0644"
    },
    {
      "path": "moonlight-core",
      "from": "build/moonlight-core",
      "mode": "0755"
    },
    {
      "path": "hint.rgba",
      "from": "build/hint.rgba",
      "mode": "0644"
    },
    {
      "path": "ffmpeg-LGPL-2.1.txt",
      "from": "build/ffmpeg-LGPL-2.1.txt",
      "mode": "0644"
    },
    {
      "path": "THIRD-PARTY.md",
      "from": "THIRD-PARTY.md",
      "mode": "0644"
    },
    {
      "path": "LICENSE",
      "from": "LICENSE",
      "mode": "0644"
    }
  ],
  "units": [
    {
      "name": "vizualyse-moonlight.service",
      "from": "systemd/vizualyse-moonlight.service"
    }
  ],
  "enable": [
    {
      "unit": "vizualyse-moonlight.service",
      "target": "multi-user.target"
    }
  ],
  "recmgr": [
    "vizualyse-moonlight"
  ],
  "crashNames": [
    "moonlight-core"
  ],
  "restart": [
    "vizualyse-moonlight.service"
  ]
}
